 arch/arm/mach-omap2/cm1_44xx.h     |    5 +++++
 arch/arm/mach-omap2/cm2_44xx.h     |   19 +++++++++++++++++++
 arch/arm/mach-omap2/prcm_mpu44xx.h |    5 +++++
 arch/arm/mach-omap2/prm44xx.h      |   15 +++++++++++++++
 4 files changed, 44 insertions(+), 0 deletions(-)

