???? ??? .sync??????? = l2x0_cache_sync,
+#endif
???? ??? .flush_all?? = l2x0_flush_all,
???? ??? .inv_all???? = l2x0_inv_all,
???? ??? .disable???? = l2x0_disable,
@@ -914,7 +924,9 @@ static const struct l2x0_of_data bcm_l2x0_data = {
