+{								\
+	.name		= "pxa168-ssp" #_id,			\
+	.id		= 0,					\
+	.probe		= pxa168_ssp_probe,			\
+	.remove		= pxa168_ssp_remove,			\
+	.suspend	= pxa168_ssp_suspend,			\
+	.resume		= pxa168_ssp_resume,			\
+	.playback	= {					\
+		.channels_min	= 1,				\
+		.channels_max	= 2,				\
+		.rates		= PXA_SSP_RATES,		\
+		.formats	= PXA_SSP_FORMATS,		\
+	},							\
+	.capture	= {					\
+		.channels_min	= 1,				\
+		.channels_max	= 2,				\
+		.rates		= PXA_SSP_RATES,		\
+		.formats	= PXA_SSP_FORMATS,		\
+	},							\
+	.ops		= &pxa168_ssp_dai_ops,			\
+}
+
+struct snd_soc_dai pxa168_ssp_dai[] = {
+	PXA168_SSP_DAI(0),
+	PXA168_SSP_DAI(1),
+	PXA168_SSP_DAI(2),
+	PXA168_SSP_DAI(3),
+	PXA168_SSP_DAI(4),
+};
+EXPORT_SYMBOL_GPL(pxa168_ssp_dai);
