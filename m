+	ret = da8xx_register_i2c(0, &mityomap_i2c_0_pdata);
+	if (ret)
+		pr_warning("mityomapl138_init: i2c0 registration failed: %d\n",
+				ret);
+
+	ret = da8xx_register_watchdog();
+	if (ret)
+		pr_warning("mityomapl138_init: watchdog registration failed: "
+			   "%d\n", ret);
+
+	davinci_serial_init(&mityomapl138_uart_config);
+
+	ret = da8xx_register_rtc();
+	if (ret)
+		pr_warning("mityomapl138_init: rtc setup failed: %d\n", ret);
+
+	ret = da850_register_cpufreq();
+	if (ret)
+		pr_warning("mityomapl138_init: cpufreq registration failed: "
+			   "%d\n", ret);
+
+	ret = da8xx_register_cpuidle();
+	if (ret)
+		pr_warning("mityomapl138_init: cpuidle registration failed: "
+			   "%d\n", ret);
+
+	mityomapl138_setup_nand();
+
+	mityomap_init_spi1(1, mityomap_spi_flash_info,
+			   ARRAY_SIZE(mityomap_spi_flash_info));
+
+	mityomapl138_setup_lcd();
+
+	mityomapl138_setup_mmc();
+
+	mityomapl138_setup_mcasp();
+}
