> >      LCR[FLV] = 0xe,   bit 17~9
> >      LCR[HLVH] = 0x1,  bit 26~18
> >      LCR[HLVL] = 0x1,  bit 31~27
> >   if input_clk = 52MHz,   LCR = 0x081c_60f9
