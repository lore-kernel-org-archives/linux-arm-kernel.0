 > --- a/sound/soc/atmel/atmel-classd.c
 > +++ b/sound/soc/atmel/atmel-classd.c
 > @@ -576,7 +576,7 @@ static int atmel_classd_probe(struct pla
 
 dd-> gclk = devm_clk_get(dev, "gclk");
 >  	if (IS_ERR(dd->aclk)) {
 > -		ret = PTR_ERR(dd->gclk);
 > +		ret = PTR_ERR(dd->aclk);

