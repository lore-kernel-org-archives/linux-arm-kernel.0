-	unsigned status;
-
-	while ((status = __raw_readl(IRQ_STATUS(IO_ADDRESS(GEMINI_INTERRUPT_BASE))))) {
-		irq = ffs(status) - 1;
-		handle_domain_irq(NULL, irq, regs);
-	}
-}
